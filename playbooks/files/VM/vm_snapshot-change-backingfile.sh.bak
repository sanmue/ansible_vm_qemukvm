#!/usr/bin/env bash

# set -x   # enable debug mode

#########################################
### change backing file path in snapshots
#########################################

VM_IMAGES_DIR_CURRENT="/home/${USER}/mnt/VM/images/" # folder containing qcow2 files, including the (external) snapshots
VM_IMAGES_DIR_OLD="/run/media/${USER}/1TB-M2NVME/01_VM/images/" # old backing file path

# all qcow2 files incl. snaphosts are already copied to VM_IMAGES_DIR_CURRENT

# check if path ${VM_IMAGES_DIR_CURRENT} exists:
if [[ ! -d "${VM_IMAGES_DIR_CURRENT}" ]]; then
	echo "Folder '${VM_IMAGES_DIR_CURRENT}' does not exist, exit."
	exit 1
fi

# search all files in folder ${VM_IMAGES_DIR_CURRENT}:
sudo find "${VM_IMAGES_DIR_CURRENT}" -maxdepth 1 -type f | 
while read -r file; do
	# get backing file if file has one:
    backing_file=$(sudo qemu-img info "${file}" | grep "backing file:" | sed "s/backing file: //") # e.g.: /run/media/USERID/1TB-M2NVME/01_VM/images/debian-102.20260123_2016

	# check if backing file exists and if it is not the same file:
    if [ -n "$backing_file" ] && [ "$backing_file" != "${file}" ]; then
        # adjust backing file path to the new one (all occurances of VM_IMAGES_DIR_OLD)
        new_backing_file="${backing_file//${VM_IMAGES_DIR_OLD}/${VM_IMAGES_DIR_CURRENT}}" # e.g.: /home/USERID/mnt/VM/images/debian-102.20260123_2016

		# show which file will be adjusted and execute rebase:
        echo "Adjust: ${file} -> Backing File: $(basename "$new_backing_file")"

        # next step fails so far since 'qemu-img rebase' (and 'qemu-img amend') check for the old backing paths
        # which do not exist anymore, since my external usb device is now mounted via fstab on another path
        if ! sudo qemu-img rebase -b "${new_backing_file}" "${file}"; then
		# if ! sudo qemu-img amend --progress --options backing_file="${new_backing_file}" "${file}"; then
			echo "Failed to adjust backing file for '${file}'"
			continue
		fi

	else
		echo "Skipping file '${file}': contains no 'backing file :' or it is the backing file itself."
    fi

done
